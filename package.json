{
  "name": "crossfit-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc --project tsconfig.vercel.json",
    "test": "npm run test --workspaces"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
